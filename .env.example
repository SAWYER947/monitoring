# Optional local-development bootstrap. Uncomment and replace both values.
# ADMIN_USERNAME=choose-your-own-username
# ADMIN_PASSWORD=generate-a-unique-password-at-least-12-characters-long

# Optional: use a random secret of at least 32 characters in managed deployments.
# Without this, a local-only key is generated in .data/session.key.
# SESSION_SECRET=

# PORT=4173
# HOST=127.0.0.1
# DATA_DIR=./.data
# TRUST_PROXY=0
